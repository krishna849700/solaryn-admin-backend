// Prisma schema for Solaryn — Leads & CMS backend
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Contact details
  name        String
  phone       String
  email       String?
  address     String?
  city        String?

  // Enquiry-specific details
  source      String   @default("SITE_AUDIT") // SITE_AUDIT, CONTACT, NEWSLETTER, OTHER
  monthlyBill String?  // e.g. "₹4,000"
  roofType    String?  // e.g. "RCC", "Tin/Metal", "Other"
  message     String?

  // Admin workflow
  status      String   @default("NEW") // NEW, CONTACTED, QUOTED, WON, LOST
  notes       String?  // internal notes added by admin
  whatsappSent Boolean @default(false)

  @@index([status])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     String
  category  String   @default("general") // hero, contact, services, images
  updatedAt DateTime @updatedAt
}
