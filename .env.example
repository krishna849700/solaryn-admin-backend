# --- Database ---
# Get a free Postgres DB from https://neon.tech or https://vercel.com/storage/postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Admin panel ---
# The password you'll type in to log into /admin
ADMIN_PASSWORD="choose-a-strong-password"
# Random secret used to sign admin session cookies — generate with:
# openssl rand -base64 32
ADMIN_JWT_SECRET="paste-a-random-32+-char-secret-here"

# --- WhatsApp alerts (CallMeBot) ---
# 1. Save +34 644 51 95 23 as a contact named "CallMeBot" on the phone that should get alerts
# 2. From that phone, WhatsApp it: "I allow callmebot to send me messages"
# 3. You'll receive your personal API key — put it below
WHATSAPP_ALERT_PHONE="919876543210"   # your phone incl. country code, digits only
WHATSAPP_CALLMEBOT_APIKEY="123456"

# --- Misc ---
# Used to build the "view lead" link inside WhatsApp alerts
NEXT_PUBLIC_APP_URL="https://your-domain.com"
